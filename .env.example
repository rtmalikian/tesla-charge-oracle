# Copy to .env (never commit .env) or run `tcoracle setup` and answer a few
# plain-language questions — it writes .env for you.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Your cars: nickname=VIN pairs, comma-separated. A nickname alone works too
# (add the VIN later at pairing time). Find a VIN in the Tesla app under
# Controls -> Software.
TCO_VEHICLES=Model Y=,Model 3=

# The chat server this app exposes (OpenAI-compatible).
TCO_SERVER_HOST=127.0.0.1
TCO_SERVER_PORT=8646
TCO_SERVER_API_KEY=
TCO_MODEL_ID=tesla-charge-oracle

# Pluggable AI backend (any OpenAI-compatible API). Default: local Ollama.
# Set TCO_AI_MODE=never for built-in answers only — nothing leaves this computer.
TCO_AI_BASE_URL=http://localhost:11434/v1
TCO_AI_API_KEY=
TCO_AI_MODEL=llama3.1
TCO_AI_MODE=auto
TCO_AI_TIMEOUT_SECONDS=20
TCO_EMBEDDING_DIM=384
TCO_TOKEN_FILE=~/.tco/tokens.json
TCO_DATA_DIR=~/.tco
TCO_DRY_RUN=0

# Your usual charge: target level, current level, pack size, charger speed.
TCO_TARGET_SOC=90
TCO_CURRENT_SOC=40
TCO_BATTERY_KWH=75
TCO_CHARGE_KW=11.5
TCO_EFFICIENCY=0.90
TCO_DEADLINE=7:00 AM

# Time-of-use bands (prefilled with typical California values).
# Peak = expensive evening window; off-peak runs from peak end overnight
# until TCO_OFFPEAK_END; mid-peak = everything else.
TCO_PEAK_START=4:00 PM
TCO_PEAK_END=9:00 PM
TCO_OFFPEAK_END=8:00 AM
TCO_RATE_PEAK=0.55
TCO_RATE_MID=0.35
TCO_RATE_OFFPEAK=0.25
